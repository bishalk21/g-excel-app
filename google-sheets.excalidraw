      "isDeleted": false,
      "boundElements": [],
      "updated": 1777540551270,
      "link": null,
      "locked": false,
      "text": "- if one node is cyclic, graph is cyclic\n- on node visit, make it visited \n  - on start, visited[node] = true\n              dfsVisited[node] = true\n  - on end, dfsVisited[node] = false\n- if on already visted[node], go back\n- if visited[node] && dfsVisited[node]\n  - cycle detected",
      "fontSize": 54.13330078124996,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- if one node is cyclic, graph is cyclic\n- on node visit, make it visited \n  - on start, visited[node] = true\n              dfsVisited[node] = true\n  - on end, dfsVisited[node] = false\n- if on already visted[node], go back\n- if visited[node] && dfsVisited[node]\n  - cycle detected",
      "autoResize": true,
      "lineHeight": 1.25
    },
